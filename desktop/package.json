{
  "name": "argoni-stock-management-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Argoni Stock Management - aplicativo desktop",
  "author": "Argoni",
  "main": "main.js",
  "scripts": {
    "prepare:backend": "node scripts/prepare-backend.js",
    "prepare:frontend": "node scripts/prepare-frontend.js",
    "prepare:jre": "node scripts/prepare-jre.js",
    "prepare:resources": "npm run prepare:backend && npm run prepare:frontend && npm run prepare:jre",
    "start": "electron .",
    "dist": "npm run prepare:resources && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.argoni.stockmanagement",
    "productName": "Argoni Stock Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "nkgabriiel",
      "repo": "panther-stock-management"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Argoni Stock Management"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
